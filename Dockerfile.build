FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
COPY tsconfig.json ./
COPY tsconfig.mcp.json ./

# Install yarn and dependencies
RUN corepack enable && yarn install

# Copy source
COPY src/ ./src/

# Build
RUN yarn build

# Verify
# Verify the build produced a valid entry point
RUN node -e "require('./dist/index.js')"
