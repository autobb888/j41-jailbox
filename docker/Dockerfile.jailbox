# Hardened jailbox MCP image.
#
# Built locally by jailbox on first run (DockerManager.ensureHardenedImage) so
# the full sandbox — including Wall 3 (bubblewrap) — ships with the tool and does
# NOT depend on whatever the host has preinstalled.
#
# The base is pinned BY DIGEST: this is the supply-chain anchor. It MUST match
# MCP_BASE_IMAGE_DIGEST in src/docker.ts. Update both together with:
#   docker pull node:18-alpine && \
#   docker inspect --format='{{index .RepoDigests 0}}' node:18-alpine
FROM node@sha256:8d6421d663b4c28fd3ebc498332f249011d118945588d0a35cb9bc4b8ca09d9e

# Wall 3: bubblewrap re-sandboxes the MCP server inside the container.
RUN apk add --no-cache bubblewrap

# Re-sandbox entrypoint. mcp-server.js is bind-mounted read-only at /app at
# runtime (not baked in) so the dispatcher always runs the version it shipped.
COPY entrypoint-jailbox.sh /app/entrypoint-jailbox.sh
RUN chmod 0555 /app/entrypoint-jailbox.sh

# The `node` user (uid/gid 1000) ships in the base image; the container is run as
# this (or the host's non-root uid) via the `User` spec — never as root.
ENTRYPOINT ["/app/entrypoint-jailbox.sh"]
CMD ["node", "/app/mcp-server.js"]
